# Release signing config — copy to `keystore.properties` (gitignored) and fill in real values.
# Generate an upload keystore with:
#   keytool -genkeypair -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias passwordy-upload
#
# `storeFile` is resolved relative to the frontend/ (root) project directory.
storeFile=upload-keystore.jks
storePassword=CHANGEME
keyAlias=passwordy-upload
keyPassword=CHANGEME
