# Copy to .env.prod (gitignored) and fill in real values, then:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
# See DEPLOYMENT.md for how to generate the secrets and configure SMTP.

# Published backend image (override if you build/host your own).
APP_IMAGE=ghcr.io/adhamamr01/passwordy/backend:latest

# --- PostgreSQL ---
POSTGRES_DB=passwordy
POSTGRES_USER=passwordy
POSTGRES_PASSWORD=CHANGEME_strong_db_password

# --- Crypto secrets ---
# JWT signing key:        openssl rand -base64 64
JWT_SECRET=CHANGEME_base64_jwt_secret
# AES-256 vault key:      openssl rand -base64 32
# WARNING: rotating this makes existing encrypted vault entries undecryptable.
ENCRYPTION_SECRET_KEY=CHANGEME_base64_aes_256_key

# --- Public URL (used in verification/reset email links) ---
APP_BASE_URL=https://api.your-domain.example
APP_MAIL_FROM=no-reply@your-domain.example

# --- SMTP ---
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_USERNAME=CHANGEME_smtp_username
SMTP_PASSWORD=CHANGEME_smtp_password
